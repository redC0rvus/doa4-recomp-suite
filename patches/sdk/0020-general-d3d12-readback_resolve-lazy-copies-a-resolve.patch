+  // readback_resolve=lazy: resolves whose CPU copy waits for the first CPU
+  // access. Their guest pages are no-access until filled. In resolve order.
+  // Protected by the global critical region.
+  struct LazyReadback {
+    uint64_t key;
+    uint32_t address;  // Physical.
+    uint32_t length;
+    const void* source;  // Mapped readback buffer.
+    uint64_t submission;
+  };
+  std::vector<LazyReadback> lazy_readbacks_;
+  // A lazy readback was recorded into the open submission (command processor
+  // thread only); ending the submission before waiting lets the CPU get it.
+  bool lazy_readback_in_open_submission_ = false;
+  uint32_t lazy_readback_thread_id_ = 0;
+  static bool LazyReadbackProviderThunk(void* context, uint32_t address, uint32_t length,
+                                        bool discard,
+                                        std::unique_lock<std::recursive_mutex>& global_lock);
+  bool LazyReadbackProvide(uint32_t address, uint32_t length, bool discard,
+                           std::unique_lock<std::recursive_mutex>& global_lock);
+  // Indices of the pending readbacks sharing pages with the range, transitively
+  // (filling one unprotects its pages), in resolve order.
+  std::vector<size_t> LazyReadbackClosure(uint32_t address, uint32_t length) const;
+  // Copies, unprotects and removes; global lock held, GPU work complete.
+  void LazyReadbackFill(const std::vector<size_t>& indices, bool discard);
