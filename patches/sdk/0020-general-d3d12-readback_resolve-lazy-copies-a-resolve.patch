+void PhysicalHeap::SetDataProviderProtection(uint32_t physical_address, uint32_t length,
+                                             bool protect) {
+  uint32_t physical_address_offset = GetPhysicalAddress(heap_base_);
+  if (physical_address < physical_address_offset) {
+    if (physical_address_offset - physical_address >= length) {
+      return;
+    }
+    length -= physical_address_offset - physical_address;
+    physical_address = physical_address_offset;
+  }
+  uint32_t heap_relative_address = physical_address - physical_address_offset;
+  if (heap_relative_address >= heap_size_ || !length) {
+    return;
+  }
+  length = std::min(length, heap_size_ - heap_relative_address);
+  uint32_t system_page_first = (heap_relative_address + host_address_offset()) / system_page_size_;
+  uint32_t system_page_last =
+      std::min((heap_relative_address + length - 1 + host_address_offset()) / system_page_size_,
+               system_page_count_ - 1);
+  uint8_t* protect_base = membase_ + heap_base_;
+  // Batch runs of pages with the same target access into one Protect call.
+  uint32_t run_first = UINT32_MAX;
+  rex::memory::PageAccess run_access = rex::memory::PageAccess::kNoAccess;
+  for (uint32_t i = system_page_first; i <= system_page_last + 1; ++i) {
+    bool page_valid = false;
+    rex::memory::PageAccess access = rex::memory::PageAccess::kNoAccess;
+    if (i <= system_page_last) {
+      uint32_t guest_page_number =
+          rex::sat_sub(i * system_page_size_, host_address_offset()) >> page_size_shift_;
+      if (guest_page_number < page_table_.size()) {
+        access = ToPageAccess(page_table_[guest_page_number].current_protect);
+        // Inaccessible pages need real access violations - leave them alone.
+        page_valid = access != rex::memory::PageAccess::kNoAccess;
+        if (protect) {
+          access = rex::memory::PageAccess::kNoAccess;
+        } else if (system_page_flags_[i >> 6].notify_on_invalidation &
+                   (uint64_t(1) << (i & 63))) {
+          access = rex::memory::PageAccess::kReadOnly;
+        }
+      }
+    }
+    if (run_first != UINT32_MAX && (!page_valid || access != run_access)) {
+      rex::memory::Protect(protect_base + run_first * system_page_size_,
+                           (i - run_first) * system_page_size_, run_access);
+      run_first = UINT32_MAX;
+    }
+    if (page_valid && run_first == UINT32_MAX) {
+      run_first = i;
+      run_access = access;
+    }
+  }
+}
