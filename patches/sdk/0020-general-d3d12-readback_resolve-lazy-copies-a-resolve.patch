+bool D3D12CommandProcessor::LazyReadbackProviderThunk(
+    void* context, uint32_t address, uint32_t length, bool discard,
+    std::unique_lock<std::recursive_mutex>& global_lock) {
+  return static_cast<D3D12CommandProcessor*>(context)->LazyReadbackProvide(address, length,
+                                                                           discard, global_lock);
+}
+
+std::vector<size_t> D3D12CommandProcessor::LazyReadbackClosure(uint32_t address,
+                                                               uint32_t length) const {
+  // Page granularity: protection is per 4 KB page, so readbacks sharing a page
+  // must be filled together, in resolve order.
+  constexpr uint32_t kPageShift = 12;
+  std::vector<bool> taken(lazy_readbacks_.size(), false);
+  std::vector<std::pair<uint32_t, uint32_t>> page_ranges = {
+      {address >> kPageShift, (address + std::max(length, 1u) - 1) >> kPageShift}};
+  bool grew = true;
+  while (grew) {
+    grew = false;
+    for (size_t i = 0; i < lazy_readbacks_.size(); ++i) {
+      if (taken[i]) {
+        continue;
+      }
+      const LazyReadback& entry = lazy_readbacks_[i];
+      uint32_t first = entry.address >> kPageShift;
+      uint32_t last = (entry.address + entry.length - 1) >> kPageShift;
+      for (const auto& range : page_ranges) {
+        if (first <= range.second && last >= range.first) {
+          taken[i] = true;
+          page_ranges.emplace_back(first, last);
+          grew = true;
+          break;
+        }
+      }
+    }
+  }
+  std::vector<size_t> indices;
+  for (size_t i = 0; i < taken.size(); ++i) {
+    if (taken[i]) {
+      indices.push_back(i);
+    }
+  }
+  return indices;
+}
+
+void D3D12CommandProcessor::LazyReadbackFill(const std::vector<size_t>& indices, bool discard) {
+  for (size_t i : indices) {
+    const LazyReadback& entry = lazy_readbacks_[i];
+    if (!discard) {
+      uint8_t* destination = memory_->TranslatePhysical(entry.address);
+      if (destination) {
+        std::memcpy(destination, entry.source, entry.length);
+      }
+    }
+  }
+  for (size_t i : indices) {
+    memory_->SetPhysicalDataProviderProtection(lazy_readbacks_[i].address,
+                                               lazy_readbacks_[i].length, false);
+  }
+  for (auto it = indices.rbegin(); it != indices.rend(); ++it) {
+    lazy_readbacks_.erase(lazy_readbacks_.begin() + *it);
+  }
+}
+
+bool D3D12CommandProcessor::LazyReadbackProvide(
+    uint32_t address, uint32_t length, bool discard,
+    std::unique_lock<std::recursive_mutex>& global_lock) {
+  bool provided = false;
+  while (true) {
+    std::vector<size_t> indices = LazyReadbackClosure(address, length);
+    if (indices.empty()) {
+      return provided;
+    }
+    provided = true;
+    uint64_t needed_submission = 0;
+    for (size_t i : indices) {
+      needed_submission = std::max(needed_submission, lazy_readbacks_[i].submission);
+    }
+    if (!discard && submission_fence_->GetCompletedValue() < needed_submission) {
+      if (rex::thread::current_thread_system_id() == lazy_readback_thread_id_) {
+        // The command processor itself touched the range; it can submit.
+        CheckSubmissionFence(needed_submission);
+      } else {
+        // Let the command processor run (it may need the lock to reach the
+        // point where it submits), then recheck - the entries may have changed.
+        global_lock.unlock();
+        static thread_local HANDLE wait_event = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+        uint32_t waited_ms = 0;
+        while (submission_fence_->GetCompletedValue() < needed_submission) {
+          submission_fence_->SetEventOnCompletion(needed_submission, wait_event);
+          if (WaitForSingleObject(wait_event, 1000) == WAIT_TIMEOUT) {
+            waited_ms += 1000;
+            REXGPU_WARN("Lazy readback: waited {} ms for submission {} (0x{:08X})", waited_ms,
+                        needed_submission, address);
+          }
+        }
+        global_lock.lock();
+        continue;
+      }
+    }
+    LazyReadbackFill(indices, discard);
+    return provided;
+  }
+}
+
+void D3D12CommandProcessor::LazyReadbackFillCompleted() {
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  if (lazy_readbacks_.empty()) {
+    return;
+  }
+  uint64_t completed = submission_fence_->GetCompletedValue();
+  size_t i = 0;
+  while (i < lazy_readbacks_.size()) {
+    if (lazy_readbacks_[i].submission > completed) {
+      ++i;
+      continue;
+    }
+    std::vector<size_t> indices =
+        LazyReadbackClosure(lazy_readbacks_[i].address, lazy_readbacks_[i].length);
+    bool all_completed = true;
+    for (size_t j : indices) {
+      all_completed &= lazy_readbacks_[j].submission <= completed;
+    }
+    if (!all_completed) {
+      ++i;
+      continue;
+    }
+    LazyReadbackFill(indices, false);
+    i = 0;
+  }
+}
+
+void D3D12CommandProcessor::PrepareForWait() {
+  // The guest may be blocked on a lazy readback from the open submission.
+  if (lazy_readback_in_open_submission_ && submission_open_) {
+    EndSubmission(false);
+  }
+  CommandProcessor::PrepareForWait();
+}
