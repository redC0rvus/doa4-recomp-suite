diff --git a/src/core/perf/latency.cpp b/src/core/perf/latency.cpp
new file mode 100644
index 0000000..aaa0b71
--- /dev/null
+++ b/src/core/perf/latency.cpp
@@ -0,0 +1,157 @@
+/**
+ * @file        core/perf/latency.cpp
+ * @brief       Dev-only input-to-present latency log, see rex/perf/latency.h
+ */
+#include <rex/perf/latency.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+
+REXCVAR_DEFINE_STRING(latency_log, "", "Perf",
+                      "Dev: write a per-guest-frame input/vblank/VdSwap/Present timing CSV "
+                      "to this path (empty = off)");
+
+namespace rex::perf::latency {
+
+namespace {
+
+// A row is written this many VdSwaps after its own, so its Present has landed.
+// ponytail: a frame still unpresented after 16 frames logs present=0 (dropped).
+constexpr uint64_t kWriteLag = 16;
+constexpr uint64_t kRows = 4096;
+
+struct Row {
+  std::atomic<int64_t> vblank, poll, press, vdswap, kick, cpswap, present;
+  std::atomic<int32_t> polls, queued;
+  std::atomic<uint32_t> packet;
+};
+
+std::array<Row, kRows> g_rows;
+std::atomic<uint64_t> g_vdswaps{0}, g_cpswaps{0}, g_written{0};
+std::atomic<uint64_t> g_unkicked{1};  // oldest frame whose swap packet the guest hasn't kicked
+std::atomic<int64_t> g_last_vblank{0};
+std::FILE* g_file = nullptr;
+std::mutex g_file_mutex;
+
+// steady_clock is QueryPerformanceCounter on Windows; microseconds since start.
+int64_t Now() {
+  static const auto t0 = std::chrono::steady_clock::now();
+  return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                               t0)
+             .count() +
+         1;  // 0 means "no event"
+}
+
+Row& RowFor(uint64_t frame) { return g_rows[frame % kRows]; }
+
+void SetOnce(std::atomic<int64_t>& slot, int64_t value) {
+  int64_t expected = 0;
+  slot.compare_exchange_strong(expected, value, std::memory_order_relaxed);
+}
+
+void WriteRow(uint64_t frame) {
+  Row& r = RowFor(frame);
+  std::lock_guard<std::mutex> lock(g_file_mutex);
+  if (!g_file) {
+    g_file = std::fopen(REXCVAR_GET(latency_log).c_str(), "w");
+    if (!g_file) {
+      REXLOG_ERROR("latency_log: cannot open {}", REXCVAR_GET(latency_log));
+      return;
+    }
+    std::fputs("frame,t_vblank,t_poll,t_press,polls,t_vdswap,cp_queued,t_kick,t_cpswap,t_present\n",
+               g_file);
+    REXLOG_INFO("latency_log: writing {}", REXCVAR_GET(latency_log));
+  }
+  std::fprintf(g_file, "%llu,%lld,%lld,%lld,%d,%lld,%d,%lld,%lld,%lld\n",
+               static_cast<unsigned long long>(frame), static_cast<long long>(r.vblank.load()),
+               static_cast<long long>(r.poll.load()), static_cast<long long>(r.press.load()),
+               r.polls.load(), static_cast<long long>(r.vdswap.load()), r.queued.load(),
+               static_cast<long long>(r.kick.load()), static_cast<long long>(r.cpswap.load()),
+               static_cast<long long>(r.present.load()));
+  if (frame % 60 == 0) {
+    std::fflush(g_file);
+  }
+  g_written.store(frame, std::memory_order_relaxed);
+  for (auto* a : {&r.vblank, &r.poll, &r.press, &r.vdswap, &r.kick, &r.cpswap, &r.present}) {
+    a->store(0, std::memory_order_relaxed);
+  }
+  r.polls.store(0, std::memory_order_relaxed);
+  r.queued.store(0, std::memory_order_relaxed);
+}
+
+}  // namespace
+
+bool Enabled() {
+  static const bool enabled = !REXCVAR_GET(latency_log).empty();
+  return enabled;
+}
+
+void OnPoll(bool new_press) {
+  if (!Enabled()) return;
+  int64_t t = Now();
+  // Polls before the next VdSwap belong to the frame that VdSwap ends.
+  Row& r = RowFor(g_vdswaps.load(std::memory_order_relaxed) + 1);
+  int64_t expected = 0;
+  if (r.poll.compare_exchange_strong(expected, t, std::memory_order_relaxed)) {
+    r.vblank.store(g_last_vblank.load(std::memory_order_relaxed), std::memory_order_relaxed);
+  }
+  r.polls.fetch_add(1, std::memory_order_relaxed);
+  if (new_press) {
+    SetOnce(r.press, t);
+  }
+}
+
+void OnVblank() {
+  if (!Enabled()) return;
+  g_last_vblank.store(Now(), std::memory_order_relaxed);
+}
+
+void OnVdSwap(uint32_t packet_address) {
+  if (!Enabled()) return;
+  int64_t t = Now();
+  uint64_t n = g_vdswaps.load(std::memory_order_relaxed) + 1;
+  Row& r = RowFor(n);
+  r.vdswap.store(t, std::memory_order_relaxed);
+  r.packet.store(packet_address, std::memory_order_relaxed);
+  // Earlier frames the command processor hasn't swapped yet.
+  r.queued.store(int32_t((n - 1) - g_cpswaps.load(std::memory_order_relaxed)),
+                 std::memory_order_relaxed);
+  g_vdswaps.store(n, std::memory_order_release);
+  if (n > kWriteLag) {
+    WriteRow(n - kWriteLag);
+  }
+}
+
+void OnKick(uint32_t ib_address, uint32_t ib_size) {
+  if (!Enabled()) return;
+  int64_t t = Now();
+  // Swap packets go out in order, so stamp the oldest unkicked frames while they fall inside.
+  uint64_t f = g_unkicked.load(std::memory_order_relaxed);
+  for (; f <= g_vdswaps.load(std::memory_order_acquire); ++f) {
+    if (RowFor(f).packet.load(std::memory_order_relaxed) - ib_address >= ib_size) break;
+    SetOnce(RowFor(f).kick, t);
+  }
+  g_unkicked.store(f, std::memory_order_relaxed);
+}
+
+uint64_t OnCpSwap() {
+  if (!Enabled()) return 0;
+  uint64_t n = g_cpswaps.fetch_add(1, std::memory_order_relaxed) + 1;
+  SetOnce(RowFor(n).cpswap, Now());
+  return n;
+}
+
+uint64_t CpFrame() { return g_cpswaps.load(std::memory_order_relaxed); }
+
+void OnPresent(uint64_t frame) {
+  if (!Enabled() || !frame || frame <= g_written.load(std::memory_order_relaxed)) return;
+  SetOnce(RowFor(frame).present, Now());
+}
+
+}  // namespace rex::perf::latency
