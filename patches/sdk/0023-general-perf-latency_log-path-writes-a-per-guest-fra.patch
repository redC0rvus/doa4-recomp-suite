new file mode 100644
index 0000000..d745a5b
--- /dev/null
+++ b/include/rex/perf/latency.h
@@ -0,0 +1,33 @@
+/**
+ * @file        perf/latency.h
+ * @brief       Dev-only input-to-present latency log (--latency_log=path.csv)
+ *
+ * One CSV row per guest frame (frame N = the Nth VdSwap): first GetState poll,
+ * first poll that saw a new button press, last guest vblank before that poll,
+ * VdSwap, the command processor's swap, and the first host Present showing it.
+ * All calls are no-ops unless the cvar is set.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::perf::latency {
+
+bool Enabled();
+// Input: every GetState of user 0; new_press = a button went down since the last poll.
+void OnPoll(bool new_press);
+void OnVblank();
+// Guest VdSwap (packet_address = physical address of its swap packet in the ring); also
+// writes finished rows.
+void OnVdSwap(uint32_t packet_address);
+// Guest kicked an indirect buffer (physical address, bytes) to the CP through the ring write
+// pointer; stamps the swap packets inside it.
+void OnKick(uint32_t ib_address, uint32_t ib_size);
+// Command processor executing a swap packet; returns its frame number.
+uint64_t OnCpSwap();
+// Latest frame the command processor swapped (0 = none yet).
+uint64_t CpFrame();
+// Host Present of an image that holds this frame.
+void OnPresent(uint64_t frame);
+
+}  // namespace rex::perf::latency
