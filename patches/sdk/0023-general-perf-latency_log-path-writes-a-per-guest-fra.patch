 void CommandProcessor::UpdateWritePointer(uint32_t value) {
-  write_ptr_index_ = value;
+  uint32_t old_value = write_ptr_index_.exchange(value);
+  if (rex::perf::latency::Enabled() && old_value != 0xBAADF00D && primary_buffer_size_) {
+    // VdSwap writes its packet into a D3D indirect buffer; report the IBs this update kicks.
+    auto* ring = reinterpret_cast<const uint32_t*>(memory_->TranslatePhysical(primary_buffer_ptr_));
+    uint32_t ring_dwords = primary_buffer_size_ / 4;
+    for (uint32_t i = old_value % ring_dwords, guard = 0; i != value % ring_dwords && guard < 4096;
+         ++guard) {
+      uint32_t header = rex::byte_swap(ring[i]);
+      uint32_t type = header >> 30;
+      uint32_t count = type == 2 ? 0 : type == 1 ? 2 : ((header >> 16) & 0x3FFF) + 1;
+      uint32_t opcode = (header >> 8) & 0x7F;
+      if (type == 3 && count >= 2 &&
+          (opcode == xenos::PM4_INDIRECT_BUFFER || opcode == xenos::PM4_INDIRECT_BUFFER_PFD)) {
+        uint32_t list_ptr = xenos::CpuToGpu(rex::byte_swap(ring[(i + 1) % ring_dwords]));
+        uint32_t list_length = rex::byte_swap(ring[(i + 2) % ring_dwords]) & 0xFFFFF;
+        rex::perf::latency::OnKick(list_ptr, list_length * 4);
+      }
+      i = (i + 1 + count) % ring_dwords;
+    }
+  }
   write_ptr_index_event_->Set();
 }
 
@@ -975,6 +995,7 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   uint32_t frontbuffer_height = reader->ReadAndSwap<uint32_t>();
   reader->AdvanceRead((count - 4) * sizeof(uint32_t));
 
+  rex::perf::latency::OnCpSwap();
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
   ++counter_;
