+  // 8bpp. The guest unit at 1x tiled address A is stored at
+  // A * scale_x * scale_y + (rx * scale_y + ry) * unit_bytes, (rx, ry) being
+  // the scaled unit inside it (column-major), each holding consecutive scaled
+  // pixels of one row. Assuming scale_xy contiguous samples per 1x pixel
+  // picked pixels from elsewhere in the unit: stair-stepped edges and a zigzag
+  // mosaic in photos at 2x/3x.
+  uint unit_log2 = xe_downscale_pixel_size_log2 == 0u ? 3u : 4u;
+  uint pixels_per_unit_log2 = unit_log2 - xe_downscale_pixel_size_log2;
+  uint offset_1x = tile_index * tile_size_1x + pixel_index * pixel_size;
+  uint unit_index = offset_1x >> unit_log2;
