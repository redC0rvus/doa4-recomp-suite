+  uint ry = block_sample_offset / xe_downscale_scale_x;
+  uint rx = scaled_x >> pixels_per_unit_log2;
+  uint scaled_lane = scaled_x & ((1u << pixels_per_unit_log2) - 1u);
+  uint src_offset = ((unit_index * scale_xy + rx * xe_downscale_scale_y + ry) << unit_log2) +
+                    (scaled_lane << xe_downscale_pixel_size_log2);
 
