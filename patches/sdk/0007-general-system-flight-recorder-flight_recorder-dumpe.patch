diff --git a/src/system/flight_recorder.cpp b/src/system/flight_recorder.cpp
new file mode 100644
index 0000000..cb6c529
--- /dev/null
+++ b/src/system/flight_recorder.cpp
@@ -0,0 +1,87 @@
+/**
+ * @file        system/flight_recorder.cpp
+ * @brief       In-memory ring of recent events, dumped into crash bundles
+ */
+
+#include <rex/system/flight_recorder.h>
+
+#include <rex/cvar.h>
+#include <rex/thread.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+
+REXCVAR_DEFINE_BOOL(flight_recorder, false, "Debug",
+                    "Keep a ring of recent file/thread/notification/GPU events for crash bundles");
+
+namespace rex::flight {
+
+namespace {
+
+struct Entry {
+  uint64_t us;
+  uint32_t frame;
+  uint32_t tid;
+  char text[112];
+};
+
+// ponytail: lock-free slots, so an entry being written during the dump can
+// come out torn. Fine for a crash log; add a per-slot sequence if it matters.
+template <size_t N>
+struct RingBuf {
+  std::array<Entry, N> slots{};
+  std::atomic<uint64_t> head{0};
+};
+
+RingBuf<2000> g_sys;
+RingBuf<256> g_gpu;
+std::atomic<uint32_t> g_frame{0};
+const auto g_start = std::chrono::steady_clock::now();
+
+template <size_t N>
+void Put(RingBuf<N>& r, std::string_view text) {
+  Entry& e = r.slots[r.head.fetch_add(1, std::memory_order_relaxed) % N];
+  e.us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                              g_start)
+             .count();
+  e.frame = g_frame.load(std::memory_order_relaxed);
+  e.tid = thread::current_thread_id();
+  size_t n = std::min(text.size(), sizeof(e.text) - 1);
+  std::memcpy(e.text, text.data(), n);
+  e.text[n] = 0;
+}
+
+template <size_t N>
+void DumpRing(std::ostream& out, const char* title, const RingBuf<N>& r) {
+  uint64_t head = r.head.load();
+  uint64_t first = head > N ? head - N : 0;
+  out << fmt::format("== {} ({} of {} events) ==\n", title, head - first, head);
+  for (uint64_t i = first; i < head; ++i) {
+    const Entry& e = r.slots[i % N];
+    out << fmt::format("{:10.3f}s f{:<6} t{:08X} {}\n", e.us / 1e6, e.frame, e.tid, e.text);
+  }
+}
+
+}  // namespace
+
+bool Enabled() { return REXCVAR_GET(flight_recorder); }
+
+void Record(Ring ring, std::string_view text) {
+  if (ring == Ring::kGpu)
+    Put(g_gpu, text);
+  else
+    Put(g_sys, text);
+}
+
+void NextFrame() { g_frame.fetch_add(1, std::memory_order_relaxed); }
+
+void Dump(std::ostream& out) {
+  out << fmt::format("frame {} at dump\n", g_frame.load());
+  DumpRing(out, "sys", g_sys);
+  DumpRing(out, "gpu", g_gpu);
+}
+
+}  // namespace rex::flight
