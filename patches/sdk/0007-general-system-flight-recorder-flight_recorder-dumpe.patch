diff --git a/include/rex/system/flight_recorder.h b/include/rex/system/flight_recorder.h
new file mode 100644
index 0000000..3af76e2
--- /dev/null
+++ b/include/rex/system/flight_recorder.h
@@ -0,0 +1,31 @@
+/**
+ * @file        rex/system/flight_recorder.h
+ * @brief       In-memory ring of recent events, dumped into crash bundles
+ */
+
+#pragma once
+
+#include <ostream>
+#include <string_view>
+#include <utility>
+
+#include <fmt/format.h>
+
+namespace rex::flight {
+
+// Sys: file opens/reads, threads, notifications (2000 entries).
+// Gpu: render target / resolve setups, kept apart so per-frame GPU churn
+// can't push the sys events out (256 entries).
+enum class Ring { kSys, kGpu };
+
+bool Enabled();  // --flight_recorder
+void Record(Ring ring, std::string_view text);
+void NextFrame();  // call once per guest swap; every entry is stamped with it
+void Dump(std::ostream& out);
+
+template <class... Args>
+void Log(Ring ring, fmt::format_string<Args...> f, Args&&... args) {
+  if (Enabled()) Record(ring, fmt::format(f, std::forward<Args>(args)...));
+}
+
+}  // namespace rex::flight
