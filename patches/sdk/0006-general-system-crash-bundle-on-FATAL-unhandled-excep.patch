+/**
+ * @file        rex/system/crash_bundle.h
+ * @brief       Self-contained crash bundle (summary, log tail, dump, save, frame)
+ */
+
+#pragma once
+
+#include <filesystem>
+
+namespace rex::crash {
+
+// On REX_FATAL (abort) or an unhandled host exception, write
+// <crash_bundle_dir>/<timestamp>/ with summary.txt, breadcrumbs.txt, args.txt,
+// crash.dmp, save/ (a copy of save_dir) and frame.bmp. Call once after the
+// runtime and logging are set up. save_dir may be empty.
+void Install(const std::filesystem::path& save_dir);
+
+}  // namespace rex::crash
diff --git a/src/system/CMakeLists.txt b/src/system/CMakeLists.txt
index fc46d86..a751b71 100644
--- a/src/system/CMakeLists.txt
+++ b/src/system/CMakeLists.txt
@@ -42,6 +42,7 @@ set(REXSYSTEM_SOURCES
     map_parser.cpp
     module.cpp
     function_dispatcher.cpp
+    crash_bundle.cpp
     gpu_plugin_loader.cpp
     thread.cpp
