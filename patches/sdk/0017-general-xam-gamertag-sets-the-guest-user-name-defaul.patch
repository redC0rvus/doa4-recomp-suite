From 1bb13dd1201500204c3eb6a6ae0b5084334dfef6 Mon Sep 17 00:00:00 2001
From: redC0rvus <111829302+redC0rvus@users.noreply.github.com>
Date: Thu, 15 Oct 2026 23:00:45 -0700
Subject: [PATCH 17/24] [general] xam: --gamertag sets the guest user name
 (default User, max 15 chars)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/system/xam/user_profile.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/system/xam/user_profile.cpp b/src/system/xam/user_profile.cpp
index a77f5e6..551925e 100644
--- a/src/system/xam/user_profile.cpp
+++ b/src/system/xam/user_profile.cpp
@@ -9,14 +9,20 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <algorithm>
 #include <sstream>
 
 #include <fmt/format.h>
 
+#include <rex/cvar.h>
 #include <rex/logging.h>
 #include <rex/system/kernel_state.h>
 #include <rex/system/xam/user_profile.h>
 
+REXCVAR_DEFINE_STRING(gamertag, "User", "Kernel",
+                      "Guest user name (gamertag), max 15 characters. Games may copy it into "
+                      "their saves, so existing saves keep the old name");
+
 namespace rex {
 namespace system {
 namespace xam {
@@ -26,7 +32,11 @@ UserProfile::UserProfile() {
   // if non-zero, it prevents the user from playing the game.
   // "You do not have permissions to perform this operation."
   xuid_ = 0xB13EBABEBABEBABE;
-  name_ = "User";
+  name_ = REXCVAR_GET(gamertag);
+  name_.resize(std::min<size_t>(name_.size(), 15));  // Xbox 360 gamertags are 15 characters max.
+  if (name_.empty()) {
+    name_ = "User";
+  }
 
   // https://cs.rin.ru/forum/viewtopic.php?f=38&t=60668&hilit=gfwl+live&start=195
   // https://github.com/arkem/py360/blob/master/py360/constants.py
