From 10ba45cb417dad3029818aec0df5a556edc9d869 Mon Sep 17 00:00:00 2001
From: redC0rvus <111829302+redC0rvus@users.noreply.github.com>
Date: Sun, 11 Oct 2026 22:46:17 -0700
Subject: [PATCH 01/24] [general] d3d12: F11 captures one guest frame under
 RenderDoc

Under RenderDoc, F11 captures one whole guest frame (swap to swap).
RenderDoc's own F12 only grabs the presenter blit, not the guest frame.
GetAsyncKeyState needs no hook. Started as a capture.request file poll
(DOAX2); squashed into this patch at the Phase 5 ledger review.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/d3d12/command_processor.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 19874a5..f929c8f 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -9,6 +9,8 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <filesystem>
+#include <rex/ui/renderdoc_api.h>
 #include <algorithm>
 #include <cstdarg>
 #include <cstring>
@@ -2254,6 +2256,24 @@ void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbu
   // End the frame even if did not present for any reason (the image refresher
   // was not called), to prevent leaking per-frame resources.
   EndSubmission(true);
+
+  // DOAX2 debug: under RenderDoc, F11 captures one whole guest frame (swap to
+  // swap). RenderDoc's own F12 only grabs the presenter's blit.
+  static auto renderdoc = rex::ui::RenderDocAPI::CreateIfConnected();
+  static bool capturing = false;
+  static bool f11_was_down = false;
+  if (renderdoc) {
+    bool f11_down = (GetAsyncKeyState(VK_F11) & 0x8000) != 0;
+    if (capturing) {
+      renderdoc->api_1_0_0()->EndFrameCapture(nullptr, nullptr);
+      capturing = false;
+      REXGPU_INFO("DOAX2: RenderDoc guest-frame capture finished");
+    } else if (f11_down && !f11_was_down) {
+      renderdoc->api_1_0_0()->StartFrameCapture(nullptr, nullptr);
+      capturing = true;
+    }
+    f11_was_down = f11_down;
+  }
 }
 
 void D3D12CommandProcessor::OnPrimaryBufferEnd() {
